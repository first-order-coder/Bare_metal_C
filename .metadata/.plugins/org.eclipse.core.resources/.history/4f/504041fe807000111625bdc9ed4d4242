#include "stm32f0xx.h"
#include "stm32f0xx_nucleo.h"

int factor(int x) //counting the factorial of a value
{
	if(x == 1)
		return (1);
	return (x * factor(x - 1));
}
			

int main(void)
{

	const int x = 5;
	int result = factor(x);
	printf("The result is: %i", result);

}
