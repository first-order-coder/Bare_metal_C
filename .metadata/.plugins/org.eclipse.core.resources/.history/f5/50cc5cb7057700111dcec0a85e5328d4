#include "stm32f0xx.h"
#include "stm32f0xx_nucleo.h"
#include <stdio.h>
#include <stdint.h>

int factor(int x) //counting the factorial of a value
{
	if(x == 1)
		return (1);
	return (x * factor(x - 1));
}
			
