#include "stm32f0xx.h"
#include "stm32f0xx_nucleo.h"

#define DOT_TIME 	200
#define DASH_TIME 	600
#define SYMBOL_GAP	200
#define LETTER_GAP	600
#define WORD_GAP	1400

void led_on(void)
{
	HAL_GPIO_WritePin(LED2_GPIO_PORT, LED2_PIN, GPIO_PIN_SET);
}

void led_off(void)
{
	HAL_GPIO_WritePin(LED2_GPIO_PORT, LED2_PIN, GPIO_PIN_RESET);
}

void blink_dot(void)
{
	led_on();
	HAL_Delay(DOT_TIME);
	led_off();
	HAL_Delay(SYMBOL_GAP);
}

void blink_dash(void)
{
	led_on();
	HAL_Delay(DASH_TIME);
	led_off();
	HAL_Delay(SYMBOL_GAP);
}

void blink_morse(char letter)
{
	if (letter == 'H')
	{
		blink_dot();
		blink_dot();
		blink_dot();
		blink_dot();
	}
	 else if (letter == 'E')
	{
		blink_dot();
	}
	else if (letter == 'L')
	{
		blink_dot();
		blink_dash();
		blink_dot();
		blink_dot();
	}
	else if (letter == 'O')
	{
		blink_dash();
		blink_dash();
		blink_dash();
	}
	else if (letter == 'W')
	{
		blink_dot();
		blink_dash();
		blink_dash();
	}
	else if (letter == 'R')
	{
		blink_dot();
		blink_dash();
		blink_dot();
	}
	else if (letter == 'D')
	{
		blink_dash();
		blink_dot();
		blink_dot();
	}
	else if (letter == ' ')
	{
		HAL_Delay(WORD_GAP);
	}

	    HAL_Delay(LETTER_GAP);

}
			
int main(void)
{
	GPIO_InitTypeDef GPIO_LedInit; //Init for the LED
	GPIO_InitTypeDef GPIO_ButtonInit; //Init for the push button
	GPIO_PinState result; // The result of reading the pin

	HAL_Init();

	//LED clock initialization
	LED2_GPIO_CLK_ENABLE();

	//Initialize LED
	GPIO_LedInit.Pin = LED2_PIN;
	GPIO_LedInit.Mode = GPIO_MODE_OUTPUT_PP;
	GPIO_LedInit.Pull = GPIO_PULLUP;
	GPIO_LedInit.Speed = GPIO_SPEED_FREQ_HIGH;
	HAL_GPIO_Init(LED2_GPIO_PORT, &GPIO_LedInit);

	//Push button clock initialization
	USER_BUTTON_GPIO_CLK_ENABLE();
	/* Configure GPIO pin : For button*/
	GPIO_ButtonInit.Pin = USER_BUTTON_PIN;
	GPIO_ButtonInit.Mode = GPIO_MODE_INPUT;
	GPIO_ButtonInit.Pull = GPIO_PULLDOWN;
	GPIO_ButtonInit.Speed = GPIO_SPEED_FREQ_HIGH;
	HAL_GPIO_Init(USER_BUTTON_GPIO_PORT, &GPIO_ButtonInit);

	char message[] = "HELLO WORLD";
	int index = 0;

	for(;;){
		//Get the current state of the push button
		result = HAL_GPIO_ReadPin(USER_BUTTON_GPIO_PORT, USER_BUTTON_PIN);

		if(result == GPIO_PIN_SET) //if result registered at the push btn is high (meaning push btn is not pressed)
		   HAL_GPIO_WritePin(LED2_GPIO_PORT, LED2_PIN, GPIO_PIN_SET); //then the led will stay high (turned on)
		else
			HAL_GPIO_WritePin(LED2_GPIO_PORT, LED2_PIN, GPIO_PIN_RESET); // else led will turn off (when push btn is pressed)

	};
}
