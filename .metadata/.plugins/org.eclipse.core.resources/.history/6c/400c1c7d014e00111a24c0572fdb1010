#include <stdio.h>

int main()
{
	short int aShortInt;
	int aInteger;
	long int aLongInt;
	long long int aLongLongInt;

	printf("Size of (short int = %ld (bytes) %ld bits\n", sizeof(aShortInt), sizeof(aShortInt) * 8);
	printf("Size of (int) = %ld (bytes) %ld bits\n", sizeof(aShortInt), sizeof(aInteger) * 8);
	printf("Size of (long int) = %ld (bytes) %ld bits\n", sizeof(aShortInt), sizeof(aShortInt) * 8);
	printf("Size of (long long int) = %ld (bytes) %ld bits\n", sizeof(aLongLongInt), sizeof(aShortInt) * 8);
}

